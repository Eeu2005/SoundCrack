{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 23",
  "_version": "23.0.0",
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "outDir": "./out",
    "resolveJsonModule": true,
    "allowImportingTsExtensions":false,
    "noEmit": false,
    "module": "nodenext",
    "target": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext"
  }
}